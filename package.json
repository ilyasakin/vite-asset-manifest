{
  "name": "vite-asset-manifest",
  "version": "0.1.1",
  "description": "Vite 8 plugin that emits an asset manifest (manifest.json) mapping source filenames to hashed output paths. API-compatible port of rspack-manifest-plugin / webpack-manifest-plugin for backend asset pipelines (Rails, Phoenix, Django, Laravel, server-rendered apps).",
  "license": "MIT",
  "author": "İlyas Akın <ashnwor@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyasakin/vite-asset-manifest.git"
  },
  "bugs": {
    "url": "https://github.com/ilyasakin/vite-asset-manifest/issues"
  },
  "homepage": "https://github.com/ilyasakin/vite-asset-manifest#readme",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:build": "pnpm -r build",
    "example:dev": "pnpm --filter basic-example dev"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "vite-8",
    "vite8",
    "rolldown",
    "rollup",
    "rollup-plugin",
    "manifest",
    "manifest-json",
    "asset-manifest",
    "asset-pipeline",
    "assets",
    "hash",
    "hashing",
    "fingerprint",
    "fingerprinting",
    "cache-busting",
    "webpack-manifest-plugin",
    "rspack-manifest-plugin",
    "webpack-manifest",
    "rspack-manifest",
    "rails",
    "phoenix",
    "django",
    "laravel",
    "ssr",
    "backend",
    "build-tool",
    "bundler",
    "esbuild",
    "esm",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.0.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
